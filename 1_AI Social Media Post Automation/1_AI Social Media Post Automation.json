    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst caption = (response.text || '').trim();\nconst wordCount = caption.split(/\\s+/).filter(Boolean).length;\n\nconst topic = $('Normalize Input').first().json.topic;\nconst scheduledAt = $('Normalize Input').first().json.scheduledAt;\nconst platforms = $('Normalize Input').first().json.platforms;\n\nlet retryCount = 1;\ntry {\n  retryCount = ($('Check Word Count').first().json.retryCount || 0) + 1;\n} catch (e) {\n  retryCount = 1;\n}\n\nconst isValid = wordCount >= 90 && wordCount <= 150;\n\nreturn [{\n  json: {\n    topic,\n    scheduledAt,\n    platforms,\n    caption,\n    wordCount,\n    isValid,\n    retryCount,\n    proceedToImage: isValid || retryCount >= 3\n  }\n}];"
      },
      "id": "53a0f564-0d55-48a0-8eec-5be711207256",
      "name": "Check Word Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1504,
        112
      ],
      "notes": "proceedToImage is true once the caption is in range, OR after 3 attempts (so a stubborn topic never loops forever). Tighten or loosen that cap as you like."
    },
    {
      "parameters": {
